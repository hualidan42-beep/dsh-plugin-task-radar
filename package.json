{
  "name": "dsh-plugin-task-radar",
  "version": "0.7.1",
  "description": "工作小管家：整帧浮动的树形小窗，按工作区归堆，会话下探出子代理，实时看谁在跑 / 谁等你 / 谁刚完成，每个任务带 Token 消耗，点一下直达；主区面板有总览带、Token 流水（今天/本周/本月）、可直接给整个界面换肤，六套自带插画的主题（默认桂花月兔）。",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task",
    "monitor",
    "overlay"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:icon": "node scripts/build-icon.mjs",
    "build:art": "node scripts/build-theme-art.mjs",
    "icon:sheet": "node scripts/icon-sheet.mjs",
    "verify": "node verify/radar-unit.mjs && node verify/apply-smoke.mjs",
    "showcase": "node verify/showcase.mjs",
    "verify:contrast": "node verify/contrast.mjs",
    "gen:deco": "node scripts/gen-deco.mjs",
    "build:deco": "node scripts/build-deco.mjs",
    "shot": "node scripts/shot-showcase.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "gen:hero": "node scripts/gen-hero.mjs",
    "opt:hero": "node scripts/opt-hero.mjs",
    "art:hero": "node scripts/gen-hero.mjs && node scripts/opt-hero.mjs && node scripts/build-deco.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "renderer",
        "layout",
        "sidebar"
      ]
    }
  }
}